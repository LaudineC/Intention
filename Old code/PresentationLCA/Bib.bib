  title = {{{DAG With Omitted Objects Displayed}} ({{DAGWOOD}}): {{A Framework}} for {{Revealing Causal Assumptions}} in {{DAGs}}},
  shorttitle = {{{DAG With Omitted Objects Displayed}} ({{DAGWOOD}})},
