  shorttitle = {Poor but Not by Choice(s)},
  author = {Ruggeri, Kai and Ashcroft-Jones, Sarah and Landini, Giampaolo Abate Romero and Al-Zahli, Narjes and Alexander, Natalia and Andersen, Mathias Houe and Bibilouri, Katherine and Busch, Katharina and Chen, Jennifer and Doubravová, Barbora and Dugue, Tatianna M. and Durrani, Aleena Asfa and Garcia-Garzon, Eduardo and Gomes, Christian and Gracheva, Aleksandra and Grilc, Neža and Gurol, Deniz Misra and Heidenry, Zoe and Hu, Clara Amanda and Krasner, Rachel and Levin, Romy and Li, Justine and Messenger, Ashleigh and Miralem, Melika and Nilsson, Fredrik and Oberschulte, Julia and Obi, Takashi and Park, Sun Young and Pascu, Daria Stefania and Pelica, Sofia and Pyrkowski, Maksymilian and Rabanal, Katherinne and Ranc, Pika and Recek, Žiga Mekiš and Symeonidou, Alexandra and Tutuska, Olivia Symone and Vdovic, Milica and Yuan, Qihang and Stock, Friederike},
  date = {2022-08-28T15:20:22},
  doi = {10.31234/osf.io/mrxy6},
  url = {https://psyarxiv.com/mrxy6/},
  urldate = {2022-08-31},
  abstract = {While economic inequality continues to rise within countries, efforts to address it have been largely ineffective, particularly those involving behavioral approaches. It is often implied but not tested that patterns among low-income individuals may be a factor impeding behavioral interventions aimed at improving upward economic mobility. To test this, we assessed rates of ten cognitive biases across nearly 5,000 participants from 27 countries, comparing between low-income adults and individuals that had overcome financial disadvantages as children, known as positive deviants. Using discrete and complex models, we find robust evidence of no differences within or between groups or countries. We therefore conclude without reservation that choices impeded by cognitive biases alone cannot explain why some individuals do not experience upward economic mobility. Policies must combine both behavioral and structural interventions to improve financial well-being across populations.},
