@article{mckenzieBaselineFollowupCase2012,
  title = {Beyond {{Baseline}} and {{Follow-up}}: {{The Case}} for {{More T}} in {{Experiments}}},
  shorttitle = {Beyond {{Baseline}} and {{Follow-Up}}},
  author = {McKenzie, David},
  date = {2012-11},
  journaltitle = {Journal of Development Economics},
  shortjournal = {Journal of Development Economics},
  volume = {99},
  number = {2},
  pages = {210--221},
  abstract = {The vast majority of randomized experiments in economics rely on a single baseline and single follow-up survey. While such a design is suitable for study of highly autocorrelated and relatively precisely measured outcomes in the health and education domains, it is unlikely to be optimal for measuring noisy and relatively less autocorrelated outcomes such as business profits, and household incomes and expenditures. Taking multiple measurements of such outcomes at relatively short intervals allows one to average out noise, increasing power. When the outcomes have low autocorrelation and budget is limited, it can make sense to do no baseline at all. Moreover, I show how for such outcomes, more power can be achieved with multiple follow-ups than allocating the same total sample size over a single follow-up and baseline. I also highlight the large gains in power from ANCOVA analysis rather than difference-in-differences analysis when autocorrelations are low.}
}

@article{mckenzieIdentifyingSpurringHighGrowth2017,
  title = {Identifying and {{Spurring High-Growth Entrepreneurship}}: {{Experimental Evidence}} from a {{Business Plan Competition}}},
  shorttitle = {Identifying and {{Spurring High-Growth Entrepreneurship}}},
  author = {McKenzie, David},
  date = {2017-08-01},
  journaltitle = {American Economic Review},
  shortjournal = {American Economic Review},
  volume = {107},
  number = {8},
  pages = {2278--2307},
  abstract = {Almost all firms in developing countries have fewer than ten workers, with a modal size of one. Are there potential high-growth entrepreneurs, and can public policy help identify them and facilitate their growth? A large-scale national business plan competition in Nigeria provides evidence on these questions. Random assignment of US\textbackslash 34 million in grants provided each winner with approximately US\textbackslash 50,000. Surveys tracking applicants over five years show that winning leads to greater firm entry, more survival, higher profits and sales, and higher employment, including increases of over 20 percentage points in the likelihood of a firm having ten or more workers. (JEL D22, L11, L26, L53, M13, O14)}
}

