@article{araujoReformingPolicySingleParent2018,
  title = {Reforming {{Policy}} for {{Single-Parent Families}} to {{Reduce Child Poverty}}},
  author = {Araujo, Maria Caridad and Meyer, Daniel R.},
  date = {2018},
  journaltitle = {RSF: The Russell Sage Foundation Journal of the Social Sciences},
  shortjournal = {RSF: The Russell Sage Foundation Journal of the Social Sciences},
  volume = {4},
  number = {2},
  pages = {91},
  abstract = {We argue that child support, the central program specifically targeting single-p\textbackslash - arent families, should increase financial resources for children living with a single parent, with a secondary goal of holding parents responsible for supporting their children. Current child support policy is substantially successful for divorcing families in which the noncustodial parent has at least moderate formal earnings. However, the system does not work well for lower-\textbackslash -income families, especially unmarried couples: far too few children regularly receive substantial support and the system is sometimes counterproductive to encouraging parental responsibility. We propose: a public guarantee of a minimum amount of support per child, assurances that no noncustodial parent will be charged beyond their current means, and a broadening of child support services.}
}

