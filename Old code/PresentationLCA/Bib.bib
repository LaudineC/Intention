@article{rothbaumParentsRelianceWeb2008,
  title = {Parents' Reliance on the {{Web}} to Find Information about Children and Families: {{Socio-economic}} Differences in Use, Skills and Satisfaction},
  shorttitle = {Parents' Reliance on the {{Web}} to Find Information about Children and Families},
  author = {Rothbaum, Fred and Martland, Nancy and Beswick, Joanne},
  date = {2008-03-01},
  journaltitle = {Journal of Applied Developmental Psychology},
  shortjournal = {Journal of Applied Developmental Psychology},
  volume = {29},
  pages = {118--128},
  doi = {10.1016/j.appdev.2007.12.002},
  abstract = {This research examines socio-economic status (SES) differences in parents' Web use, skills, and satisfaction. A total of 120 parents were interviewed about their use of the Web to find child and family information, and they provided feedback as they searched for information online. Findings indicate that the higher the SES level (a) the greater the use of the Web; (b) the more sophisticated the search skills (e.g., selecting one's own search engine rather than relying on a default; changing keywords); and (c) the greater the skills in evaluation (e.g., emphasizing the credibility of the sponsoring organization). In contrast to the digital divide in Web use and skills, there was no evidence of greater satisfaction among higher SES parents. These findings have implications for programs to assure that all parents have access to relevant and trustworthy online information pertaining to their children.}
}

