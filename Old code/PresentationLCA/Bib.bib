@article{weberDscoreMetricInterpreting2019,
  title = {The {{D-score}}: {{A Metric}} for {{Interpreting}} the {{Early Development}} of {{Infants}} and {{Toddlers}} across {{Global Settings}}},
  shorttitle = {The {{D-score}}},
  author = {Weber, Ann M and Rubio-Codina, Marta and Walker, Susan P and family=Buuren, given=Stef, prefix=van, useprefix=true and Eekhout, Iris and Grantham-McGregor, Sally M and Araujo, Maria Caridad and Chang, Susan M and Fernald, Lia CH and Hamadani, Jena Derakhshani and Hanlon, Charlotte and Karam, Simone M and Lozoff, Betsy and Ratsifandrihamanana, Lisy and Richter, Linda and Black, Maureen M},
  date = {2019-11},
  journaltitle = {BMJ Global Health},
  shortjournal = {BMJ Glob Health},
  volume = {4},
  number = {6},
  pages = {e001724},
  abstract = {Introduction\textbackslash hspace0.6em Early childhood development can be described by an underlying latent construct. Global comparisons of children's development are hindered by the lack of a validated metric that is comparable across cultures and contexts, especially for children under age 3\textbackslash,years. We constructed and validated a new metric, the Developmental Score (D-\textbackslash -score), using existing data from 16 longitudinal studies. Methods\textbackslash hspace0.6em Studies had item-l\textbackslash -evel developmental assessment data for children 0– 48 months and longitudinal outcomes at ages {$>$}4– 18 years, including measures of IQ and receptive vocabulary. Existing data from 11 low-\textbackslash -income, middle-\textbackslash -income and high-i\textbackslash -ncome countries were merged for {$>$}36\textbackslash,000 children. Item mapping produced 95 `equate groups' of same-\textbackslash -skill items across 12 different assessment instruments. A statistical model was built using the Rasch model with item difficulties constrained to be equal in a subset of equate groups, linking instruments to a common scale, the D-\textbackslash -score, a continuous metric with interval-\textbackslash -scale properties. D-\textbackslash -score-\textbackslash - for-\textbackslash -age z-\textbackslash -scores (DAZ) were evaluated for discriminant, concurrent and predictive validity to outcomes in middle childhood to adolescence. Results\textbackslash hspace0.6em Concurrent validity of DAZ with original instruments was strong (average r=0.71), with few exceptions. In approximately 70\% of data rounds collected across studies, DAZ discriminated between children above/below cut-\textbackslash -points for low birth weight ({$<$}2500\textbackslash,g) and stunting (-2 SD below median height-\textbackslash - for-\textbackslash -age). DAZ increased significantly with maternal education in 55\% of data rounds. Predictive correlations of DAZ with outcomes obtained 2– 16 years later were generally between 0.20 and 0.40. Correlations equalled or exceeded those obtained with original instruments despite using an average of 55\% fewer items to estimate the D-\textbackslash -score. Conclusion\textbackslash hspace0.6em The D-\textbackslash -score metric enables quantitative comparisons of early childhood development across ages and sets the stage for creating simple, low-c\textbackslash - ost, global-u\textbackslash - se instruments to facilitate valid cross-\textbackslash -national comparisons of early childhood development.}
}

