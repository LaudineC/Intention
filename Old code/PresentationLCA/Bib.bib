@article{unverPerceivedAccessibilityChildcare2018,
  title = {Perceived Accessibility of Childcare in {{Europe}}: A Cross-Country Multilevel Study},
  shorttitle = {Perceived Accessibility of Childcare in {{Europe}}},
  author = {Ünver, Özgün and Bircan, Tuba and Nicaise, Ides},
  date = {2018-12},
  journaltitle = {International Journal of Child Care and Education Policy},
  shortjournal = {ICEP},
  volume = {12},
  number = {1},
  pages = {5},
  issn = {2288-6729},
  doi = {10.1186/s40723-018-0044-3},
  url = {https://ijccep.springeropen.com/articles/10.1186/s40723-018-0044-3},
  urldate = {2020-02-28},
  abstract = {Perceptions of users regarding the accessibility of childcare services have been underresearched. The present study addresses this gap by looking into the effect of systemic level characteristics of the ECEC system on the perceived accessibility of childcare at the individual level. Perceived accessibility is composed of perceived affordability, availability, quality and physical accessibility of these services. The socio-ecological model at the micro-level and the model of institutional setting of ECEC (provision, regulation and financing) at the macro-level are combined in multilevel analyses. Our finding is that childcare is perceived to be more accessible in countries that (1) do not allow private commercial profit-making ECEC services for 3–6-year-old children, (2) adopt a unitary ECEC system where services for 0–3-year-olds and 3–6-year-olds are harmonised and (3) provide generous public support per 0–5-year-old child in the ECEC system. The latter has an even stronger effect on families with an income below average.},
  langid = {english},
  file = {G\:\\Mon Drive\\Zotero\\storage\\B8Y82Q6Z\\Ünver et al. - 2018 - Perceived accessibility of childcare in Europe a .pdf;G\:\\Mon Drive\\Zotero\\storage\\E7H3CFT2\\EC0319375FRN.fr.pdf;G\:\\Mon Drive\\Zotero\\storage\\SP2KB5X5\\Ünver et al. - 2018 - Perceived accessibility of childcare in Europe a .pdf;G\:\\Mon Drive\\Zotero\\storage\\TDXYBLIV\\Ünver et al. - 2018 - Perceived accessibility of childcare in Europe a .pdf;G\:\\Mon Drive\\Zotero\\storage\\WA5H2RX7\\Lhullier2007_les associations dans la régulation locale de la petite enfance.pdf}
}

