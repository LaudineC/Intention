  pages = {719--741},
  abstract = {This paper provides an analysis of child care subsidies under welfar reform in the USA. We used data from the 1999 National Survey of America's Families to analyze the determinants of receipt of a child care subsidy and the effects of subsidy receipt on employment, school attendance, unemployment, and welfare participation. Ordinary least-squares estimates that treat subsidy receipt a exogenous show an effect of subsidy receipt on employment of about 13 percentage points. Two-stage least-squares estimates that treat subsidy receipt a endogenous and use county dummies as identifying instruments show an effect o 33 percentage points on employment, 20 percentage points on unemployment, and no effects on schooling and welfare receipt.}
}

