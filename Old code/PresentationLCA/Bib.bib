@article{Riaz,
  title = {{{THE HEALTH EFFECTS OF IN UTERO EXPOSURE TO CASH TRANSFERS}}},
  author = {Riaz, Syeda Warda and Alloush, Mo},
  abstract = {Exposure while in utero to varying environments can have long term effects on individuals. In this paper, we investigate the effects of in utero exposure to a large cash grant on the health of children. Using data from South Africa, we use the age eligibility threshold of the Older Person’s Grant and the variation in age differences between children and a co-resident elderly to show that full in utero exposure to the cash transfer led to a 0.23 SD increase in height-for-age and 0.18 SD increase in weight for age of children. These results are robust to a variety of different checks including controlling for endogenous household formation and household fixed effects. Among older children, we show that the timing of the start of these benefits is important when it comes to the cumulative effects on the height-for-age and stunting. Given the importance of early child health in determining long-term outcomes, this suggests that extending child-specific benefits to pregnant mothers can have long-term positive impacts.},
  langid = {english},
  file = {G:\Mon Drive\Zotero\storage\QZ2LKCVX\Riaz et Alloush - THE HEALTH EFFECTS OF IN UTERO EXPOSURE TO CASH TR.pdf}
}

