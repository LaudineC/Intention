@article{dalyHierarchyEvidenceAssessing2007,
  title = {A Hierarchy of Evidence for Assessing Qualitative Health Research},
  author = {Daly, Jeanne and Willis, Karen and Small, Rhonda and Green, Julie and Welch, Nicky and Kealy, Michelle and Hughes, Emma},
  date = {2007-01},
  journaltitle = {Journal of Clinical Epidemiology},
  shortjournal = {Journal of Clinical Epidemiology},
  volume = {60},
  number = {1},
  pages = {43--49},
  issn = {08954356},
  doi = {10.1016/j.jclinepi.2006.03.014},
  url = {https://linkinghub.elsevier.com/retrieve/pii/S0895435606002101},
  urldate = {2021-02-01},
  abstract = {Objective: The objective of this study is to outline explicit criteria for assessing the contribution of qualitative empirical studies in health and medicine, leading to a hierarchy of evidence specific to qualitative methods. Study Design and Setting: This paper arose from a series of critical appraisal exercises based on recent qualitative research studies in the health literature. We focused on the central methodological procedures of qualitative method (defining a research framework, sampling and data collection, data analysis, and drawing research conclusions) to devise a hierarchy of qualitative research designs, reflecting the reliability of study conclusions for decisions made in health practice and policy. Results: We describe four levels of a qualitative hierarchy of evidence-for-practice. The least likely studies to produce good evidencefor-practice are single case studies, followed by descriptive studies that may provide helpful lists of quotations but do not offer detailed analysis. More weight is given to conceptual studies that analyze all data according to conceptual themes but may be limited by a lack of diversity in the sample. Generalizable studies using conceptual frameworks to derive an appropriately diversified sample with analysis accounting for all data are considered to provide the best evidence-for-practice. Explicit criteria and illustrative examples are described for each level. Conclusion: A hierarchy of evidence-for-practice specific to qualitative methods provides a useful guide for the critical appraisal of papers using these methods and for defining the strength of evidence as a basis for decision making and policy generation. Ó 2006 Elsevier Inc. All rights reserved.},
  langid = {english},
  file = {G:\Mon Drive\Zotero\storage\99JSBEC2\Daly et al. - 2007 - A hierarchy of evidence for assessing qualitative .pdf}
}

