@article{aguiarEarlyInterventionsTackling2020,
  title = {Early Interventions Tackling Inequalities Experienced by Immigrant, Low-Income, and {{Roma}} Children in 8 {{European}} Countries: A Critical Overview},
  shorttitle = {Early Interventions Tackling Inequalities Experienced by Immigrant, Low-Income, and {{Roma}} Children in 8 {{European}} Countries},
  author = {Aguiar, Cecília and Silva, Carla S. and Guerra, Rita and Rodrigues, Ricardo B. and Ribeiro, Luísa A. and Pastori, Giulia and Leseman, Paul and {the ISOTIS research team}},
