@article{Hong,
  title = {Does {{Money Make Baby Grow}}? {{The Effect}} of {{Cash Transfer}} on {{Infant Health}}: {{Evidence}} from {{Korea}}},
  author = {Hong, Sojung},
  abstract = {In 2022, South Korea recorded the lowest total fertility rate in the world, at 0.78. To combat the rapid decline in childbirth and enhance child welfare, the Korean government introduced a nationwide child allowance policy in 2018. Using the timing of this policy as a source of identifying variation, I estimate the causal relationship between the child benefit and prenatal child development among pregnant women in recipient families using the regression discontinuity analysis. Based on population-wide, individual-level administrative data, I find that introducing the child benefit in South Korea reduced the likelihood of low birth weight and premature birth. Notably, these effects were driven by loweducated and young women. These findings support the recent research on the effect of child benefits in Spain(Libertad Gonzalez and Sofia Trommlerova, 2022) and in the UK(Reader, 2023) on birth weight. These findings suggest that providing government support to pregnant women with low socioeconomic status (SES) before childbirth can significantly increase the likelihood of delivering healthy babies, thus improving fetal health and fostering a healthier society.},
  langid = {english},
  file = {G:\Mon Drive\Zotero\storage\WJSNB3LM\Hong - Does Money Make Baby Grow The Effect of Cash Tran.pdf}
}

