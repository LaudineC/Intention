@article{kawaiJapaneseMonkeysMacaca2016,
  title = {Japanese Monkeys ({{Macaca}} Fuscata) Quickly Detect Snakes but Not Spiders: {{Evolutionary}} Origins of Fear-Relevant Animals.},
