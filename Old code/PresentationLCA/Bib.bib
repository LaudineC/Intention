@article{beatsonEarlyChildhoodEducation2022,
  title = {Early {{Childhood Education Participation}}: {{A Mixed-Methods Study}} of {{Parent}} and {{Provider Perceived Barriers}} and {{Facilitators}}},
  shorttitle = {Early {{Childhood Education Participation}}},
  author = {Beatson, Ruth and Molloy, Carly and Fehlberg, Zoe and Perini, Nicholas and Harrop, Christopher and Goldfeld, Sharon},
  date = {2022-11-01},
  journaltitle = {Journal of Child and Family Studies},
  shortjournal = {J Child Fam Stud},
  volume = {31},
  number = {11},
  pages = {2929--2946},
  issn = {1573-2843},
  doi = {10.1007/s10826-022-02274-5},
  url = {https://doi.org/10.1007/s10826-022-02274-5},
  urldate = {2023-09-22},
  abstract = {Participation in high-quality early childhood education and care (ECEC) benefits children and society. Policy recognition of this manifests through government subsidy strategies to increase ECEC access in the years immediately preceding school. Yet despite this action, many children do not receive the recommended amount. This study utilizes a mixed-methods design to investigate ECEC participation barriers and facilitators in three Australian communities. Parents and service providers completed online questionnaires (45 parents, 63 providers) and semi-structured interviews (21 parents, 16 providers). Results showed that issues related to both direct (e.g., fees) and indirect (e.g., travel) costs are particularly important barriers for families, and are well-recognized by providers. A range of factors were also considered important for facilitating participation (e.g., effective promotion of the benefits linked to high-quality play-based learning in formal settings, professional training of staff). Findings demonstrated the ecological complexity of participation. Strategies to address barriers and harness facilitators are required across multiple levels.},
  langid = {english},
  keywords = {Early childhood education,Kindergarten,Mixed methods,Parent engagement,Preschool},
  file = {G:\Mon Drive\Zotero\storage\VD64YC3Q\Beatson et al. - 2022 - Early Childhood Education Participation A Mixed-M.pdf}
}

