  shorttitle = {Spiders at the Cocktail Party},
  author = {New, Joshua J. and German, Tamsin C.},
  date = {2015-05},
  journaltitle = {Evolution and Human Behavior},
  shortjournal = {Evolution and Human Behavior},
  volume = {36},
