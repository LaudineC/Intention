@article{florianParentalMigrantStatus2021a,
  title = {Parental Migrant Status and Health Inequalities at Birth: {{The}} Role of Immigrant Educational Selectivity},
  shorttitle = {Parental Migrant Status and Health Inequalities at Birth},
  author = {Florian, Sandra and Ichou, Mathieu and Panico, Lidia},
