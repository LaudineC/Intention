@article{Singh2020,
  title = {Income Dividends and Subjective Survival in a {{Cherokee Indian}} Cohort: A Quasi-Experiment},
  shorttitle = {Income Dividends and Subjective Survival in a {{Cherokee Indian}} Cohort},
  author = {Singh, Parvati and Brown, Ryan and Copeland, William E. and Costello, E. Jane and Bruckner, Tim A.},
  date = {2020-04-01},
