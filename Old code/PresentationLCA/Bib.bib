  file = {G\:\\Mon Drive\\Zotero\\Lee et al_2012_Academic motivation mediates the influence of temporal discounting on academic.pdf;G\:\\Mon Drive\\Zotero\\storage\\2P5YD3R2\\S2211949312000026.html}
