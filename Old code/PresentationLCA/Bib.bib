  shorttitle = {Dark {{Patterns}} at {{Scale}}},
  author = {Mathur, Arunesh and Acar, Gunes and Friedman, Michael J. and Lucherini, Elena and Mayer, Jonathan and Chetty, Marshini and Narayanan, Arvind},
