@article{dufloEconomistPlumber,
  title = {The {{Economist}} as {{Plumber}}},
  author = {Duflo, Esther},
  pages = {41},
  abstract = {As economists increasingly help governments design new policies and regulations, they take on an added responsibility to engage with the details of policy making and, in doing so, to adopt the mindset of a plumber. Plumbers try to predict as well as possible what may work in the real world, mindful that tinkering and adjusting will be necessary since our models gives us very little theoretical guidance on what (and how) details will matter. This essay argues that economists should seriously engage with plumbing, in the interest of both society and our discipline.}
}

@article{dufloEvaluerImpactProgrammes2005,
  title = {Évaluer l'impact Des Programmes d'aide Au Développement : Le Rôle Des Évaluations Par Assignation Aléatoire},
  shorttitle = {Évaluer l'impact Des Programmes d'aide Au Développement},
  author = {Duflo, Esther},
  date = {2005},
  journaltitle = {Revue d'economie du developpement},
  volume = {Vol. 13},
  number = {2},
  pages = {185--226},
  publisher = {De Boeck Supérieur},
  abstract = {{$<$}titre{$>$}R\&\#233;sum\&\#233;{$<$}/titre{$>$}Parce que les programmes dont on a montr\&\#233; qu\&\#8217;ils sont une r\&\#233;ussite peuvent \&\#234;tre reproduits dans d\&\#8217;autres pays, alors que les programmes ayant \&\#233;chou\&\#233; peuvent \&\#234;tre abandonn\&\#233;s, les \&\#233;valuations d\&\#8217;impact sont des biens publics internationaux : les agences internationales devraient donc jouer un r\&\#244;le cl\&\#233; dans leur promotion et leur financement. En agissant ainsi, elles pourraient atteindre trois objectifs importants : am\&\#233;liorer les taux de rendement des programmes qu\&\#8217;elles supportent ; am\&\#233;liorer les taux de rendement des programmes que les autres d\&\#233;cideurs politiques supportent, en fournissant les observations sur la base desquelles les programmes peuvent \&\#234;tre s\&\#233;lectionn\&\#233;s ; construire un support de long terme pour l\&\#8217;aide internationale et le d\&\#233;veloppement, en rendant possible le fait de signaler de mani\&\#232;re cr\&\#233;dible les programmes qui fonctionnent et ceux qui ne fonctionnent pas.L\&\#8217;article avance qu\&\#8217;il existe des possibilit\&\#233;s consid\&\#233;rables pour \&\#233;tendre l\&\#8217;utilisation des \&\#233;valuations par assignation al\&\#233;atoire. Pour une large classe de programmes de d\&\#233;veloppement (quoique pas pour tous), les \&\#233;valuations par assignation al\&\#233;atoire peuvent \&\#234;tre utilis\&\#233;es pour surmonter les probl\&\#232;mes souvent rencontr\&\#233;s dans l\&\#8217;utilisation pratique des \&\#233;valuations. Premi\&\#232;rement, il traite de la m\&\#233;thodologie de l\&\#8217;\&\#233;valuation par assignation al\&\#233;atoire \&\#224; travers plusieurs exemples concrets, tir\&\#233;s pour la plupart du cas de l\&\#8217;Inde. Il d\&\#233;bat alors du potentiel de l\&\#8217;\&\#233;valuation par assignation al\&\#233;atoire en tant que base pour \&\#233;tendre les projets. Enfin, il traite des pratiques courantes et du r\&\#244;le que les agences internationales peuvent jouer dans la promotion et le financement d\&\#8217;\&\#233;valuations rigoureuses.Classification JEL : F35, 019.}
}

