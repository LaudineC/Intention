@article{salmanParisClimateAgreement2022,
  title = {Paris Climate Agreement and Global Environmental Efficiency: {{New}} Evidence from Fuzzy Regression Discontinuity Design},
  shorttitle = {Paris Climate Agreement and Global Environmental Efficiency},
  author = {Salman, Muhammad and Long, Xingle and Wang, Guimei and Zha, Donglan},
  date = {2022-09-01},
  journaltitle = {Energy Policy},
