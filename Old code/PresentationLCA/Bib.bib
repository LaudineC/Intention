@article{ramachandraCausalInferenceSurvival,
  title = {Causal {{Inference}} for {{Survival Analysis}}},
  author = {Ramachandra, Vikas},
  pages = {11},
  abstract = {In this paper, we propose the use of causal inference techniques for survival function estimation and prediction for subgroups of the data, upto individual units. Tree ensemble methods, specifically random forests were modified for this purpose. A real world healthcare dataset was used with about 1800 patients with breast cancer, which has multiple patient covariates as well as disease free survival days (DFS) and a death event binary indicator (y). We use the type of cancer curative intervention as the treatment variable (T=0 or 1, binary treatment case in our example).}
}

