  author = {Tolbert, Elise Marie and Maxson, Pamela},
  pages = {8},
  abstract = {Environmental influences can affect the educational aspirations of youth. This paper describes an intervention aimed at mediating the effects of negative environmental influences to increase youth educational aspirations in Tuskegee, Alabama. Tuskegee is a predominately African American community. In Tuskegee, we observed that many high school students were not performing well academically; there was a lack of cohesion between the community and university; and students at Tuskegee University, a local college, needed an avenue to interact with the community. We therefore founded Next Step Up, a mentoring and tutoring program for local high school students, to begin to address these three issues. Through Next Step Up, college students mentor and tutor local high school students, by assisting with homework, ACT/SAT practice and job applications. Next Step Up has aimed to help high school students envision and realize academic achievement while providing the college students with a unique opportunity to engage with the community and translate the academic knowledge into practice. This organization can serve as a model to inspire similar programs in disadvantaged communities.},
  langid = {english},
