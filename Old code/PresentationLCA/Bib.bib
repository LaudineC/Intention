@article{ellwoodAntiPovertyPolicyFamilies2000,
  title = {Anti-{{Poverty Policy}} for {{Families}} in the {{Next Century}}: {{From Welfare}} to {{Work}}— and {{Worries}}},
  shorttitle = {Anti-{{Poverty Policy}} for {{Families}} in the {{Next Century}}},
  author = {Ellwood, David T},
  date = {2000-02-01},
  journaltitle = {Journal of Economic Perspectives},
  shortjournal = {Journal of Economic Perspectives},
  volume = {14},
  number = {1},
  pages = {187--198},
  abstract = {This paper reveals that recent changes in social policy have included both sharp cutbacks in welfare for non-working families and dramatic increases in supports for low income working families. It explores the reasons for these changes, and documents how they have radically changed work incentives for some persons, notable single mothers. The result has been a large increase in work by low wage single parents. The paper concludes by examining several potential dangers of this new direction and explores the challenges that remain for the next century.}
}

