  author = {García-Morán, Eva and Kuehn, Zoë},
  date = {2017-01},
  journaltitle = {Review of Economic Dynamics},
  shortjournal = {Review of Economic Dynamics},
  volume = {23},
  pages = {80--98},
  abstract = {Grandparents are regular providers of free child care. Similar to other forms of child care, availability of grandparent-provided child care has positive effects on fertility and mothers' employment. However, grandparent-provided child care requires residing close to parents or in-laws which may imply spatial restrictions for labor markets. We find that West German mothers who reside close to parents or in-laws have lower wages. We build a model of residence choice, fertility decisions, and female labor force participation that can account for the observed relationships. We simulate our model to analyze how women's decisions would change if the availability of grandparent-provided child care or family policies were altered. If out-of-pocket child care costs were lowered to the Swedish level, fertility, mothers' labor force participation, and geographical mobility would increase. If more households had access to free grandparent-provided child care, fertility and mothers' labor force participation would also increase, but geographical mobility would be reduced. © 2016 Elsevier Inc. All rights reserved.}
}

@article{garciaOpportunityCostEarly,
  title = {The {{Opportunity Cost}} of {{Early Childhood Education}}: {{Formal}}, {{Informal}}, and {{Maternal Care}}\textbackslash{{LeftArrowBar}}},
  author = {Garcı a, Jorge Luis and Hojman, Andres and Shea, Joshua},
  pages = {22},
  abstract = {We decompose the total e\textbackslash carriagereturnect of a policy that gives free access to an early childhood education program on age 3 cognition, using a unique dataset with experimental and non-experimental sources of exogenous variation. We estimate a skill production function and find that two e\textbackslash carriagereturnects on cognition approximately o\textbackslash carriagereturnset each other: the positive e\textbackslash carriagereturnect of formal care and the negative e\textbackslash carriagereturnect of time lost with the mother, which we approximate by maternal labor supply. The magnitude of the policy's positive e\textbackslash carriagereturnect on hours in formal care (12.63 additional hours/week) greatly exceeds its negative e\textbackslash carriagereturnect on maternal care (2.27 fewer hours/week). We implement a causal mediation analysis to decompose the positive and sizable total e\textbackslash carriagereturnect of the policy (0.44 SDs). The e\textbackslash carriagereturnect through formal care is 0.63 SDs; the e\textbackslash carriagereturnect through loss of maternal care is 0.12 SDs. The latter e\textbackslash carriagereturnect is much stronger for high-IQ mothers, suggesting that time-intensive programs should focus on disadvantaged children.}
}

@article{garciaQuantifyingLifeCycleBenefits2019,
  title = {Quantifying the {{Life-Cycle Benefits}} of an {{Influential Early Childhood Program}}},
  author = {Garcia, Jorge Luis and Heckman, James J. and Leaf, Duncan Ermini and Prados, Maria Jose},
  date = {2019-08-02},
  journaltitle = {Journal of Political Economy},
  shortjournal = {Journal of Political Economy},
  pages = {705718},
  abstract = {This paper quantifies and aggregates the multiple lifetime benefits of an influential highquality early childhood program with outcomes measured through midlife. Guided by economic theory, we supplement experimental data with non-experimental data to forecast the life-cycle benefits and costs of the program. Our point estimate of the internal rate of return is 13.7\% with an associated benefit/cost ratio of 7.3. We account for model estimation and forecasting error and present estimates from extensive sensitivity analyses. This paper is a template for synthesizing experimental and nonexperimental data using economic theory to estimate the long-run life-cycle benefits of social programs.}
}

