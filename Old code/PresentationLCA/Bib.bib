@article{cartierPourquoiParentsPreferentils2017,
  title = {Pourquoi les parents préfèrent-ils la crèche ? Les représentations hiérarchisées des modes de garde professionnels},
  shorttitle = {Pourquoi les parents préfèrent-ils la crèche ?},
  author = {Cartier, Marie and Collet, Anaïs and Czerny, Estelle and Gilbert, Pierre and Lechien, Marie-Hélène and Monchatre, Sylvie},
  date = {2017},
  journaltitle = {Revue française des affaires sociales},
  volume = {1},
  number = {2},
  pages = {247},
  issn = {0035-2985, 2111-4358},
  doi = {10.3917/rfas.172.0247},
  url = {http://www.cairn.info/revue-francaise-des-affaires-sociales-2017-2-page-247.htm?ref=doi},
  urldate = {2021-11-05},
  abstract = {Why do parents prefer crèches? Hierarchical representations of modes of professional childcare The choice of childcare is an acute question for parents of young children in a context of rising numbers of two‑parent working families. Although the availability of crèche‑based childcare is less widespread than the availability of childminders, parents show a fairly clear rejection of the latter and award them their trust less spontaneously. Based on a study of interviews with 32 couples, the article exa‑mines the reasons for this persistent disqualification of childminders, emphasizing the social differentiation of this judgment according to gender as well as to the parents’ social position and evolution. While upper‑class parents tend to exclude the use of childminders in a manner resembling a presumption of class‑related incompetence, middle and working‑class parents express differentiated educatio‑nal and socializing expectations inspired by a cultural interest in psychology, an academic reinterpretation of early learning, and an attachment to the crèche as a preparation for kindergarten that instils discipline and autonomy in children. These expectations are compounded in the working‑class couples interviewed by a fear of entrusting their children to women who cannot be controlled and who they suspect operate outside the restrictions imposed upon employees.},
  langid = {french},
  file = {G\:\\Mon Drive\\Zotero\\storage\\4BNLGDCP\\Cartier et al. - 2017 - Pourquoi les parents préfèrent-ils la crèche  Les.pdf;G\:\\Mon Drive\\Zotero\\storage\\JDE4VILT\\Cartier et al. - 2017 - Pourquoi les parents préfèrent-ils la crèche  Les.pdf;G\:\\Mon Drive\\Zotero\\storage\\KEYDK9FF\\Cartier et al. - 2017 - Pourquoi les parents préfèrent-ils la crèche  Les.pdf}
}

