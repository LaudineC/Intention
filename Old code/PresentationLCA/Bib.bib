@article{magni-bertonHolismeDurkheimienHolisme2008,
  title = {Holisme durkheimien et holisme bourdieusien.},
  author = {Magni-Berton, Raùl},
  date = {2008-10-13},
  journaltitle = {L'Année sociologique},
  volume = {58},
  number = {2},
  pages = {299--318},
  issn = {0066-2399},
  doi = {10.3917/anso.082.0299},
  url = {https://www.cairn.info/revue-l-annee-sociologique-2008-2-page-299.htm},
  urldate = {2017-12-22},
  abstract = {Ce texte vise à apporter une contribution à la discussion concernant le paradigme holiste en sciences sociales. Il soutient que la notion de «~holisme~», telle qu’elle est présentée traditionnellement, est ambiguë et englobe deux approches radicalement distinctes et inconciliables présentes dans les sciences sociales. Ces deux approches sont présentées ici en référence à deux parmi leurs principaux défenseurs~: Durkheim pour l’une et Bourdieu pour l’autre. Après avoir présenté leurs traits principaux, cet article montrera leur incompatibilité, leur relation avec l’individualisme méthodologique et, enfin, l’importance aujourd’hui d’éviter l’assimilation entre ces deux visions de la sociologie., The aim of this paper is to contribute to the discussion about the holist paradigm in social sciences. It establishes that the concept of «~holism~», in its traditional presentation, is ambiguous and refers to two radically different and incompatible approaches in social sciences. Both approaches are presented here with reference to two of their main supporters~: the first is Durkheim, the second is Bourdieu. I present here the main features of these two approaches, their incompatibility, their relation to methodological individualism and, lastly, the importance today of avoiding any confusion between these two views on sociology.},
  langid = {french},
  keywords = {Bourdieu,Durkheim,explication,Holisme méthodologique,paradigme},
  file = {G\:\\Mon Drive\\Zotero\\storage\\E6MNGEA2\\Magni-Berton - 2008 - Holisme durkheimien et holisme bourdieusien..pdf;G\:\\Mon Drive\\Zotero\\storage\\92CTM9DD\\revue-l-annee-sociologique-2008-2-page-299.html;G\:\\Mon Drive\\Zotero\\storage\\9N2DE9KT\\Magni-Berton - 2008 - Holisme durkheimien et holisme bourdieusien..html}
}

@article{VanLancker2016,
  title = {Explaining Patterns of Inequality in Childcare Service Use across 31 Developed Economies: {{A}} Welfare State Perspective},
  shorttitle = {Explaining Patterns of Inequality in Childcare Service Use across 31 Developed Economies},
  author = {Van Lancker, Wim and Ghysels, Joris},
  date = {2016-10},
  journaltitle = {International Journal of Comparative Sociology},
  shortjournal = {International Journal of Comparative Sociology},
  volume = {57},
  number = {5},
  pages = {310--337},
  issn = {0020-7152, 1745-2554},
  doi = {10.1177/0020715216674252},
  url = {http://journals.sagepub.com/doi/10.1177/0020715216674252},
  urldate = {2020-02-27},
  abstract = {Childcare services are increasingly regarded a major policy lever to combat social inequalities in early life. Yet, it was shown that inequality in the use of childcare services is the norm rather than the exception in European and Organisation for Economic Co-operation and Development (OECD) countries. As a result, social inequalities between disadvantaged and advantaged children are likely to be reinforced instead of being narrowed. The aim of this article is to conduct a macro-level analysis exploring which welfare state characteristics are associated with inequality in childcare use. We find that government involvement in the availability, affordability and quality of service provision is related to lower levels of inequality in childcare use. The results also suggest an impact of labour market opportunities and parental leave schemes. The findings contribute to a proper understanding of the institutional mechanisms underlying inequality in childcare service use.},
  langid = {english},
  file = {G\:\\Mon Drive\\Zotero\\storage\\52RD5W5J\\ruffiot2012_Les publics des établissements d’accueil du jeune enfant. Logiques et conditions d’accès des familles en difficulté.pdf;G\:\\Mon Drive\\Zotero\\storage\\BLWRDI4S\\Quand la scolarisation à 2 ans n’a pas les effets attendus - leçons des méthodes d’évaluation.pdf;G\:\\Mon Drive\\Zotero\\storage\\DVZG439Y\\Van Lancker and Ghysels - 2016 - Explaining patterns of inequality in childcare ser.pdf;G\:\\Mon Drive\\Zotero\\storage\\EMGQ6VPN\\Kalicki2017_Article_LongitudinalStudiesInECECChallLongitudinal studies in ECEC- challenges of translating research into policy action.pdf;G\:\\Mon Drive\\Zotero\\storage\\EZVQA8XF\\VanGameren2009_ Childcare and labor force participation in the Netherlands- the importance of attitudes and opinions.pdf;G\:\\Mon Drive\\Zotero\\storage\\F6J6YT5M\\Gonzalez2005_Where do I leave my baby Use and development of early childcare in Spain.pdf;G\:\\Mon Drive\\Zotero\\storage\\GHDDQNYE\\siraj2016_Fostering Effective Early Learning_ A review of the current inter.pdf;G\:\\Mon Drive\\Zotero\\storage\\HSDPQQHS\\royal soc canada2012_early childhood development royl_.pdf;G\:\\Mon Drive\\Zotero\\storage\\MFGQGUNN\\vanderbroeck2014_Accessibility of early childhood education and care a state of affairs.pdf;G\:\\Mon Drive\\Zotero\\storage\\SJM23UJY\\vandenbroeck2008_mother's seach for infant child care- the dynamic between availability and desirability.pdf;G\:\\Mon Drive\\Zotero\\storage\\YAARWHN2\\Darragh2007_Universal Design for Early Childhood Education- Ensuring Access and Equity for All.pdf;G\:\\Mon Drive\\Zotero\\storage\\Z5GUS7Y5\\Van Lancker and Ghysels - 2016 - Explaining patterns of inequality in childcare ser.pdf}
