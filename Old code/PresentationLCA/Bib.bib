  title = {The {{Effect}} of {{Work First Job Placements}} on the {{Distribution}} of {{Earnings}}: {{An Instrumental Variable Quantile Regression Approach}}},
  author = {Autor, David H and Houseman, Susan N and Kerr, Sari Pekkala},
