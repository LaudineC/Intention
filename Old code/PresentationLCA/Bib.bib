@article{meyerDoesEducationIncrease2015,
  title = {Does Education Increase Pro-Environmental Behavior? {{Evidence}} from {{Europe}}},
  shorttitle = {Does Education Increase Pro-Environmental Behavior?},
  author = {Meyer, Andrew},
