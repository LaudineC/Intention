@incollection{lepoidevinExperiencePerceptionTime2015,
  title = {The {{Experience}} and {{Perception}} of {{Time}}},
  booktitle = {The {{Stanford Encyclopedia}} of {{Philosophy}}},
  author = {Le Poidevin, Robin},
  editor = {Zalta, Edward N.},
  date = {2015},
  edition = {Summer 2015},
  publisher = {Metaphysics Research Lab, Stanford University},
  url = {https://plato.stanford.edu/archives/sum2015/entriesime-experience/},
  urldate = {2017-11-28},
  abstract = {We see colours, hear sounds and feel textures. Some aspects of theworld, it seems, are perceived through a particular sense. Others,like shape, are perceived through more than one sense. But what senseor senses do we use when perceiving time? It is certainly notassociated with one particular sense. In fact, it seems odd to saythat we see, hear or touch time passing. And indeed, even if all oursenses were prevented from functioning for a while, we could stillnotice the passing of time through the changing pattern of ourthought. Perhaps, then, we have a special faculty, distinct from thefive senses, for detecting time. Or perhaps, as seems more likely, wenotice time through perception of other things. But how?, Time perception raises a number of intriguing puzzles, including whatit means to say we perceive time. In this article, we shallexplore the various processes through which we are made aware of time,and which influence the way we think time really is. Inevitably, weshall be concerned with the psychology of time perception, but thepurpose of the article is to draw out the philosophical issues, and inparticular whether and how aspects of our experience can beaccommodated within certain metaphysical theories concerning thenature of time and causation.},
  keywords = {Augustine Saint,memory,perception: the problem of,space and time: being and becoming in modern physics,time}
}

