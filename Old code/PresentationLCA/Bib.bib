  author = {Denham, Susanne A. and Bassett, Hideko Hamada and Thayer, Sara K. and Mincic, Melissa S. and Sirotkin, Yana S. and Zinsser, Katherine},
  date = {2012-07},
  journaltitle = {The Journal of Genetic Psychology},
  shortjournal = {The Journal of Genetic Psychology},
