  publisher = {École nationale d'administration},
  abstract = {En s\&\#8217;appuyant sur les r\&\#233;sultats de deux \&\#233;tudes r\&\#233;centes command\&\#233;es par France Strat\&\#233;gie, l\&\#8217;article propose une analyse critique du d\&\#233;veloppement institutionnel et acad\&\#233;mique de l\&\#8217;\&\#233;valuation d\&\#8217;impact des politiques publiques en France. Il montre que les \&\#233;valuations d\&\#8217;impact, reposant sur des m\&\#233;thodes statistiques contrefactuelles, repr\&\#233;sentent une part faible\&\#160;\&\#8211;\&\#160;bien que croissante\&\#160;\&\#8211;\&\#160;des \&\#233;valuations r\&\#233;alis\&\#233;es dans notre pays et qu\&\#8217;elle n\&\#8217;est produite que par quelques centres de recherche sp\&\#233;cialis\&\#233;s. Les acteurs institutionnels de l\&\#8217;\&\#233;valuation des politiques publiques (minist\&\#232;res, Parlement, Cour des comptes\&\#8230;), qui promeuvent une conception de l\&\#8217;\&\#233;valuation plus large que l\&\#8217;identification de liens de cause \&\#224; effet entre une politique et les r\&\#233;sultats observ\&\#233;s, ne font quasiment jamais appel \&\#224; ce type de m\&\#233;thodes scientifiques. Le r\&\#244;le jou\&\#233; par l\&\#8217;Insee et des services statistiques des minist\&\#232;res (SSM), \&\#224; mi-chemin entre l\&\#8217;administration et la recherche, constitue une sp\&\#233;cificit\&\#233; fran\&\#231;aise dans le d\&\#233;veloppement des pratiques d\&\#8217;\&\#233;valuation d\&\#8217;impact.}
}

@article{bonoliSocialInvestmentActive,
  title = {Social {{Investment}}, {{Active Labour Market Policies}} and {{Migration}}},
  author = {Bonoli, Giuliano},
  pages = {14},
  abstract = {Over the last few years, social investment has been at the centre of the debate on how to deal with the crisis of the European social model. The notion of social investment is based on the idea that social problems can be dealt with and inequality can be counteracted by investing in the human capital of disadvantaged individuals and groups. Against this background, the objective of this contribution is to assess the adequacy of the social investment strategy in facing the challenges posed by a multicultural society, by looking at the example of active labour market policies. Relying on meta-analytical research, it shows that access biases to policy measures as well as labour market discrimination severely limit the potential of a social investment strategy to deal with the problem of mainlining social cohesion in increasingly diverse societies. The chapter concludes by arguing that social investment and particularly active labour market policies must be adapted to the emerging European multiethnic societies, otherwise they will fail to deliver on the promise of maintaining social cohesion.}
}

